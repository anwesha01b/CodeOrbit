# ---- Database (Postgres + pgvector) ----
# Local docker-compose default, or paste a Supabase/Neon free-tier URL.
DATABASE_URL="postgresql://codeorbit:codeorbit@localhost:5432/codeorbit?schema=public"

# ---- API ----
API_PORT=3001
WEB_ORIGIN="http://localhost:5173"

# ---- Worker ----
WORKER_CONCURRENCY=2
# Where repos are shallow-cloned during analysis (deleted after each job).
WORKSPACE_DIR="./.workspaces"
MAX_REPO_FILES=15000
MAX_REPO_SIZE_MB=500

# ---- GitHub (optional, raises unauthenticated rate limits) ----
GITHUB_TOKEN=""

# ---- LLM provider (swappable: gemini | groq | ollama) ----
LLM_PROVIDER="gemini"
GEMINI_API_KEY=""
GROQ_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# ---- Embeddings (gemini | transformers) ----
EMBEDDINGS_PROVIDER="gemini"
EMBEDDING_DIM=768
